# PostgreSQL Database Connection String
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/kiran_portfolio

# Fallback SQLite DB path if local PostgreSQL is unreachable
SQLITE_FALLBACK_URL=sqlite:///./portfolio_dev.db

# API Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Email / SMTP Forwarding Settings
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mkirankumar4050@gmail.com
SMTP_PASSWORD=
NOTIFICATION_EMAIL=mkirankumar4050@gmail.com
ENABLE_EMAIL_NOTIFICATIONS=true

